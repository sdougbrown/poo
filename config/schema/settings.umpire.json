{
  "version": 1,
  "fields": {
    "version": { "required": true, "isEmpty": "number" },
    "ui": { "isEmpty": "string" },
    "models_file": { "isEmpty": "string" },
    "auth_file": { "isEmpty": "string" },
    "pi_auth_file": { "isEmpty": "string" },
    "profile": { "isEmpty": "string" },
    "profiles_files": { "isEmpty": "array" },
    "roles.chat": { "isEmpty": "string" },
    "roles.decider": { "isEmpty": "string" },
    "decider.timeout_ms": { "isEmpty": "number" },
    "permission.unmatched": { "isEmpty": "string" },
    "permission.fallback": { "isEmpty": "string" },
    "permission.doom_loop.threshold": { "isEmpty": "number" },
    "permission.doom_loop.near_threshold": { "isEmpty": "number" },
    "permission.doom_loop.action": { "isEmpty": "string" },
    "permission.askers": { "isEmpty": "array" },
    "permission.chain_timeout_s": { "isEmpty": "number" },
    "permission.decide.allow": { "isEmpty": "number" },
    "permission.decide.deny": { "isEmpty": "number" },
    "permission.decide.timeout_ms": { "isEmpty": "number" },
    "system_prompt.base_file": { "isEmpty": "string" },
    "system_prompt.replace": { "isEmpty": "string" },
    "system_prompt.append": { "isEmpty": "string" },
    "system_prompt.remove": { "isEmpty": "array" },
    "roles.compaction": { "isEmpty": "string" },
    "context.strategy": { "isEmpty": "string" },
    "context.handoff.ratio": { "isEmpty": "number" },
    "context.handoff.max_tokens": { "isEmpty": "number" },
    "context.summary.ratio": { "isEmpty": "number" },
    "context.summary.keep_recent_tokens": { "isEmpty": "number" },
    "context.summary.max_tokens": { "isEmpty": "number" },
    "context.mine.ratio": { "isEmpty": "number" },
    "context.mine.keep_recent_tokens": { "isEmpty": "number" },
    "context.mine.max_tokens": { "isEmpty": "number" },
    "context.mine.pointer_max_tokens": { "isEmpty": "number" },
    "tools.read.restrict_to_working_dir": { "isEmpty": "boolean" },
    "tools.grep.restrict_to_working_dir": { "isEmpty": "boolean" },
    "tools.edit.restrict_to_working_dir": { "isEmpty": "boolean" },
    "tools.read.ask_outside_working_dir": { "isEmpty": "boolean" },
    "tools.grep.ask_outside_working_dir": { "isEmpty": "boolean" },
    "tools.edit.ask_outside_working_dir": { "isEmpty": "boolean" },
    "tools.bash.timeout_s": { "isEmpty": "number" },
    "tools.bash.executor": { "isEmpty": "string" },
    "tools.bwrap.network": { "isEmpty": "boolean" },
    "tools.bwrap.ro_binds": { "isEmpty": "array" },
    "tools.bwrap.rw_binds": { "isEmpty": "array" },
    "tools.env.scrub": { "isEmpty": "array" },
    "tools.env.passthrough": { "isEmpty": "array" },
    "tools.protected_paths": { "isEmpty": "array" },
    "tools.codemode.engine": { "isEmpty": "string" },
    "tools.codemode.timeout_s": { "isEmpty": "number" },
    "tools.codemode.script_max_bytes": { "isEmpty": "number" },
    "tools.codemode.output_cap_chars": { "isEmpty": "number" },
    "tools.codemode.exec_steps": { "isEmpty": "number" },
    "tools.fetch.timeout_s": { "isEmpty": "number" },
    "tools.fetch.max_bytes": { "isEmpty": "number" },
    "tools.fetch.user_agent": { "isEmpty": "string" },
    "tools.fetch.allow_private_hosts": { "isEmpty": "boolean" },
    "tools.disabled": { "isEmpty": "array" },
    "limits.max_tokens_per_run": { "isEmpty": "number" },
    "limits.max_duration_s": { "isEmpty": "number" },
    "limits.max_turns": { "isEmpty": "number" },
    "limits.max_continuations": { "isEmpty": "number" },
    "jobs.max_running": { "isEmpty": "number" },
    "jobs.timeout_s": { "isEmpty": "number" },
    "jobs.on_idle": { "isEmpty": "string" },
    "jobs.max_unattended_wakes": { "isEmpty": "number" },
    "reasoning.chat": { "isEmpty": "string" },
    "finish.schema_file": { "isEmpty": "string" },
    "cli_registry.paths": { "isEmpty": "array" },
    "cli_registry.defaults": { "isEmpty": "boolean" },
    "feeds.paths": { "isEmpty": "array" },
    "feeds.defaults": { "isEmpty": "boolean" },
    "skills.default": { "isEmpty": "boolean" },
    "skills.user_path": { "isEmpty": "string" },
    "skills.paths": { "isEmpty": "array" },
    "session.mode": { "isEmpty": "string" },
    "session.dir": { "isEmpty": "string" },
    "session.project_prompt": { "isEmpty": "boolean" },
    "session.user_prompt": { "isEmpty": "boolean" },
    "session.user_prompt_file": { "isEmpty": "string" },
    "session.retention.max_age_days": { "isEmpty": "number" },
    "session.retention.max_sessions": { "isEmpty": "number" }
  },
  "conditions": {
    "has_decider": { "type": "boolean", "description": "the settings name a model for the decider role" },
    "has_cli_registry": { "type": "boolean", "description": "the settings name a cli registry" },
    "has_wire_client": { "type": "boolean", "description": "the runtime supplies a wire client to answer permission asks" }
  },
  "rules": [
    {
      "type": "requires",
      "field": "permission.decide.allow",
      "when": { "op": "cond", "condition": "has_decider" },
      "reason": "the decide threshold needs a decider model: roles.decider names one"
    },
    {
      "type": "requires",
      "field": "permission.decide.deny",
      "when": { "op": "cond", "condition": "has_decider" },
      "reason": "the decide threshold needs a decider model: roles.decider names one"
    },
    {
      "type": "requires",
      "field": "permission.decide.timeout_ms",
      "when": { "op": "cond", "condition": "has_decider" },
      "reason": "the decide timeout needs a decider model: roles.decider names one"
    },
    {
      "type": "requires",
      "field": "permission.askers",
      "when": {
        "op": "or",
        "exprs": [
          { "op": "cond", "condition": "has_decider" },
          { "op": "not", "expr": { "op": "contains", "field": "permission.askers", "value": "decide" } }
        ]
      },
      "reason": "the decide asker needs a decider model: roles.decider names one"
    },
    {
      "type": "fairWhen",
      "field": "permission.askers",
      "when": {
        "op": "or",
        "exprs": [
          { "op": "cond", "condition": "has_wire_client" },
          { "op": "not", "expr": { "op": "contains", "field": "permission.askers", "value": "wire" } }
        ]
      },
      "reason": "the wire asker needs a wire client, and this runtime has none: the chain runs without it"
    },
    {
      "type": "disables",
      "when": { "op": "present", "field": "skills.default" },
      "targets": ["skills.user_path"],
      "reason": "skills.default and skills.user_path are mutually exclusive: one names the default directory, the other the person's own"
    },
    {
      "type": "disables",
      "when": { "op": "present", "field": "skills.user_path" },
      "targets": ["skills.default"],
      "reason": "skills.default and skills.user_path are mutually exclusive: one names the default directory, the other the person's own"
    },
    {
      "type": "disables",
      "when": { "op": "present", "field": "system_prompt.base_file" },
      "targets": ["system_prompt.replace"],
      "reason": "system_prompt.base_file and system_prompt.replace are mutually exclusive"
    },
    {
      "type": "disables",
      "when": { "op": "present", "field": "system_prompt.replace" },
      "targets": ["system_prompt.base_file"],
      "reason": "system_prompt.base_file and system_prompt.replace are mutually exclusive"
    },
    {
      "type": "check",
      "field": "version",
      "op": "range",
      "min": 1,
      "max": 1,
      "reason": "the settings version must be 1"
    },
    {
      "type": "check",
      "field": "permission.unmatched",
      "op": "matches",
      "pattern": "^(allow|ask|deny)$",
      "reason": "permission.unmatched must be allow, ask or deny"
    },
    {
      "type": "check",
      "field": "permission.fallback",
      "op": "matches",
      "pattern": "^(allow|deny)$",
      "reason": "permission.fallback must be allow or deny"
    },
    {
      "type": "check",
      "field": "permission.doom_loop.action",
      "op": "matches",
      "pattern": "^(allow|ask|deny)$",
      "reason": "permission.doom_loop.action must be allow, ask or deny"
    },
    {
      "type": "check",
      "field": "context.strategy",
      "op": "matches",
      "pattern": "^(summary|mine|handoff|native|none)$",
      "reason": "context.strategy must be summary, mine, handoff, native or none"
    },
    {
      "type": "check",
      "field": "tools.codemode.engine",
      "op": "matches",
      "pattern": "^(starlark|quickjs)$",
      "reason": "tools.codemode.engine must be starlark or quickjs"
    },
    {
      "type": "check",
      "field": "jobs.on_idle",
      "op": "matches",
      "pattern": "^(wake|hold)$",
      "reason": "jobs.on_idle must be wake or hold"
    },
    {
      "type": "check",
      "field": "session.mode",
      "op": "matches",
      "pattern": "^(logged|ephemeral)$",
      "reason": "session.mode must be logged or ephemeral"
    },
    {
      "type": "check",
      "field": "reasoning.chat",
      "op": "matches",
      "pattern": "^(off|minimal|low|medium|high|xhigh|([1-9][0-9]*))$",
      "reason": "reasoning.chat must be off, minimal, low, medium, high, xhigh or a budget in tokens"
    },
    {
      "type": "check",
      "field": "tools.bash.executor",
      "op": "matches",
      "pattern": "^[a-z][a-z0-9_-]*$",
      "reason": "tools.bash.executor must be the name of a linked executor"
    },
    {
      "type": "check",
      "field": "permission.chain_timeout_s",
      "op": "min",
      "value": 1,
      "reason": "permission.chain_timeout_s must be at least a second"
    },
    {
      "type": "check",
      "field": "decider.timeout_ms",
      "op": "min",
      "value": 1,
      "reason": "decider.timeout_ms must be at least a millisecond"
    },
    {
      "type": "check",
      "field": "permission.decide.timeout_ms",
      "op": "min",
      "value": 1,
      "reason": "permission.decide.timeout_ms must be at least a millisecond"
    },
    {
      "type": "check",
      "field": "permission.decide.allow",
      "op": "range",
      "min": 0,
      "max": 1,
      "reason": "permission.decide.allow must be between 0 and 1"
    },
    {
      "type": "check",
      "field": "permission.decide.deny",
      "op": "range",
      "min": 0,
      "max": 1,
      "reason": "permission.decide.deny must be between 0 and 1"
    },
    {
      "type": "check",
      "field": "permission.doom_loop.threshold",
      "op": "min",
      "value": 1,
      "reason": "permission.doom_loop.threshold must be at least one repeat"
    },
    {
      "type": "check",
      "field": "permission.doom_loop.near_threshold",
      "op": "min",
      "value": 1,
      "reason": "permission.doom_loop.near_threshold must be at least one repeat"
    },
    {
      "type": "check",
      "field": "limits.max_tokens_per_run",
      "op": "min",
      "value": 0,
      "reason": "limits.max_tokens_per_run must not be negative"
    },
    {
      "type": "check",
      "field": "limits.max_duration_s",
      "op": "min",
      "value": 0,
      "reason": "limits.max_duration_s must not be negative"
    },
    {
      "type": "check",
      "field": "limits.max_turns",
      "op": "min",
      "value": 0,
      "reason": "limits.max_turns must not be negative"
    },
    {
      "type": "check",
      "field": "limits.max_continuations",
      "op": "min",
      "value": 0,
      "reason": "limits.max_continuations must not be negative"
    },
    {
      "type": "check",
      "field": "jobs.max_running",
      "op": "min",
      "value": 0,
      "reason": "jobs.max_running must not be negative"
    },
    {
      "type": "check",
      "field": "jobs.timeout_s",
      "op": "min",
      "value": 0,
      "reason": "jobs.timeout_s must not be negative"
    },
    {
      "type": "check",
      "field": "jobs.max_unattended_wakes",
      "op": "min",
      "value": 0,
      "reason": "jobs.max_unattended_wakes must not be negative"
    },
    {
      "type": "check",
      "field": "context.handoff.ratio",
      "op": "range",
      "min": 0,
      "max": 1,
      "reason": "context.handoff.ratio must be between 0 and 1"
    },
    {
      "type": "check",
      "field": "context.handoff.max_tokens",
      "op": "min",
      "value": 0,
      "reason": "context.handoff.max_tokens must not be negative"
    },
    {
      "type": "check",
      "field": "context.summary.ratio",
      "op": "range",
      "min": 0,
      "max": 1,
      "reason": "context.summary.ratio must be between 0 and 1"
    },
    {
      "type": "check",
      "field": "context.summary.keep_recent_tokens",
      "op": "min",
      "value": 0,
      "reason": "context.summary.keep_recent_tokens must not be negative"
    },
    {
      "type": "check",
      "field": "context.summary.max_tokens",
      "op": "min",
      "value": 0,
      "reason": "context.summary.max_tokens must not be negative"
    },
    {
      "type": "check",
      "field": "context.mine.ratio",
      "op": "range",
      "min": 0,
      "max": 1,
      "reason": "context.mine.ratio must be between 0 and 1"
    },
    {
      "type": "check",
      "field": "context.mine.keep_recent_tokens",
      "op": "min",
      "value": 0,
      "reason": "context.mine.keep_recent_tokens must not be negative"
    },
    {
      "type": "check",
      "field": "context.mine.max_tokens",
      "op": "min",
      "value": 0,
      "reason": "context.mine.max_tokens must not be negative"
    },
    {
      "type": "check",
      "field": "context.mine.pointer_max_tokens",
      "op": "min",
      "value": 0,
      "reason": "context.mine.pointer_max_tokens must not be negative"
    },
    {
      "type": "check",
      "field": "session.retention.max_age_days",
      "op": "min",
      "value": 0,
      "reason": "session.retention.max_age_days must not be negative"
    },
    {
      "type": "check",
      "field": "session.retention.max_sessions",
      "op": "min",
      "value": 0,
      "reason": "session.retention.max_sessions must not be negative"
    }
  ]
}
