{
  "openai": {
    "id": "openai",
    "name": "OpenAI",
    "api": "https://api.openai.com/v1",
    "doc": "https://platform.openai.com/docs",
    "env": ["OPENAI_API_KEY"],
    "models": {
      "gpt-5": {
        "id": "gpt-5",
        "name": "GPT-5",
        "reasoning": true,
        "tool_call": true,
        "temperature": false,
        "knowledge": "2025-09-01",
        "release_date": "2025-08-07",
        "modalities": {
          "input": ["text", "image"],
          "output": ["text"]
        },
        "cost": {
          "input": 1.25,
