#!/bin/sh
# A fixture feed: a message, a blank line, another message, a line with no
# text, and a message after it that the runner must not deliver.
printf '{"text": "the message before the blank"}\n'
printf '\n'
printf '{"text": "the message after the blank"}\n'
printf '{"from": "x"}\n'
printf '{"text": "the message after the failure"}\n'
sleep 60
