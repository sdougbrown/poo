#!/bin/sh
# A fixture filter: it answers with three records, the middle one naming
# an image the session cannot read.
cat >/dev/null
printf '{"text": "the first message", "from": "alice"}\n'
printf '{"text": "the look", "from": "alice", "image": {"path": "missing.png"}}\n'
printf '{"text": "the third message", "from": "alice"}\n'
